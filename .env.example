# Use URL-safe random characters for POSTGRES_PASSWORD.
POSTGRES_PASSWORD=replace-with-a-long-random-value
CORS_ORIGINS=http://localhost:8080
WEATHER_ENABLED=true
# Optional: free noncommercial Open-Meteo endpoint needs no key.
# Set a licensed customer key for commercial service.
OPEN_METEO_API_KEY=
EXPERT_NAME=Agricultural support
EXPERT_EMAIL=
FOLLOWUP_DAYS=7
