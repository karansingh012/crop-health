            "minLength": 1,
            "title": "Crop"
          },
          "area": {
            "type": "number",
            "maximum": 10000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Area"
          },
          "location": {
            "type": "string",
            "maxLength": 200,
            "title": "Location",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name",
          "crop",
          "area"
        ],
        "title": "FieldInput"
      },
      "FieldOut": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "crop": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Crop"
          },
